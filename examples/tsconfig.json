{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": [],
        "allowImportingTsExtensions": true,
        "paths": {
            "@pmndrs/sandbox": [
                "../src/index.ts"
            ],
            "@pmndrs/sandbox/react": [
                "../src/react/index.ts"
            ]
        }
    },
    "include": [
        "./src",
        "vite-env.d.ts"
    ],
    "exclude": [
        "./dist"
    ]
}
